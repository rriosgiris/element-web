.mx_JitsiGroupCallToast_container {
    .mx_JitsiGroupCallToast {
        display: flex;
        flex-direction: column;
        gap: var(--cpd-space-4); /* espace entre contenu et boutons */
        padding: var(--cpd-space-4); /* espace global avec les bords */
        background: var(--cpd-color-bg-subtle-primary);
        border-radius: var(--cpd-radius-md);
        border: 1px solid var(--cpd-color-border-interactive-primary);

        .mx_JitsiGroupCallToast_content {
            background-color: transparent !important;
            border-color: transparent !important;
            display: flex;
            align-items: flex-start;
            gap: var(--cpd-space-3);
            width: 100%;
            /* ✅ ESPACE AVEC LES BORDS DU FOND GRIS */
            padding: var(--cpd-space-3);
            border-radius: var(--cpd-radius-sm);

            .mx_JitsiGroupCallToast_text {
                flex: 1;
                min-width: 0;

                .mx_JitsiGroupCallToast_description {
                    font-size: var(--cpd-font-size-body-sm);
                    color: var(--cpd-color-text-secondary);
                }
            }
        }

        .mx_JitsiGroupCallToast_buttons {
            display: flex;
            justify-content: center; /* 🎯 centré */
            gap: var(--cpd-space-3);

             /* espace interne par rapport au fond gris */
            padding: var(--cpd-space-2) 0 0;

            /* espace entre boutons et bord du container */
            padding: var(--cpd-space-2) var(--cpd-space-3) 0;

            button {
                white-space: nowrap;
                flex-shrink: 0;
            }
        }
    }
}
