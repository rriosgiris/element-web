.mx_JitsiGroupCallToast_container {
    .mx_JitsiGroupCallToast {
        display: flex;
        align-items: center;
        gap: var(--cpd-space-3);
        padding: var(--cpd-space-3) var(--cpd-space-4);
        background: var(--cpd-color-bg-subtle-primary);
        border-radius: var(--cpd-radius-md);
        border: 1px solid var(--cpd-color-border-interactive-primary);

        .mx_JitsiGroupCallToast_content {
            display: flex;
            align-items: center;
            gap: var(--cpd-space-3);
            flex: 1;

            .mx_JitsiGroupCallToast_icon {
                width: 24px;
                height: 24px;
                min-width: 24px;
                color: var(--cpd-color-icon-secondary);
            }

            .mx_JitsiGroupCallToast_text {
                flex: 1;
                min-width: 0;

                .mx_JitsiGroupCallToast_title {
                    font-weight: 500;
                    font-size: var(--cpd-font-size-body-md);
                    color: var(--cpd-color-text-primary);
                    margin-bottom: var(--cpd-space-1);
                }

                .mx_JitsiGroupCallToast_description {
                    font-size: var(--cpd-font-size-body-sm);
                    color: var(--cpd-color-text-secondary);
                }
            }
        }

        .mx_JitsiGroupCallToast_buttons {
            display: flex;
            gap: var(--cpd-space-2);
            flex-wrap: wrap;
            align-items: center;

            button {
                white-space: nowrap;
                flex-shrink: 0;
            }
        }
    }
}
